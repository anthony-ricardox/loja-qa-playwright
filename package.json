{
  "name": "meu-projeto-playwright",
  "version": "1.0.0",
  "description": "Automação E2E da LojaQA (Login) com Playwright, TypeScript, Page Object Model, Fixtures e Data-Driven",
  "private": true,
  "scripts": {
